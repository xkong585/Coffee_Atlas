# Copy to .env.local for local development. Never commit .env.local or real values.
# Without any of these the app still runs: the catalog works, and accounts,
# payments and AI recommendations report that they are not connected.

# Enable ONLY to inspect synthetic contract examples at /api/dev/fixtures in local development.
# The fixture route is always disabled in production, even when this is true.
ENABLE_DEV_FIXTURES=false

# Accounts, preferences, saved items and paid access (Member 3).
# Local: a SQLite file, created with its schema on first use.
# Hosted: a Turso database, e.g. libsql://coffee-atlas-<you>.turso.io, plus its token.
DATABASE_URL=file:./data/coffee-atlas.db
DATABASE_AUTH_TOKEN=
# At least 32 random characters, e.g. the output of: openssl rand -hex 32
AUTH_SECRET=
# Public base URL, used for Stripe return links. Falls back to the request origin.
APP_URL=http://localhost:3000

# Stripe TEST mode only (sk_test_... keys; live keys are refused).
# STRIPE_PRICE_ID is a one-time price, e.g. price_... for "Unlimited recommendations".
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` locally or the dashboard endpoint when hosted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# AI recommendations (Member 5) and the AI trip map (Member 4) share this server-side key.
MODEL_API_KEY=
MODEL_NAME=

# AI trip map: true uses the SAME one-time unlock as unlimited recommendations.
# /api/trip checks AccountsService.getAccess; trip plans do not spend free recommendations.
# Leave false for an open demo; set true on the server when enabling paid trips.
TRIP_REQUIRES_ACCESS=false

# Never prefix secret values with NEXT_PUBLIC_. Keep actual values out of Git.
