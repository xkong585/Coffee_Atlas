{
  "name": "coffee-atlas-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Independent main foundation for the coffee discovery capstone.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:check": "vitest run tests/unit/catalog-data.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@libsql/client": "0.18.0",
    "maplibre-gl": "5.24.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
